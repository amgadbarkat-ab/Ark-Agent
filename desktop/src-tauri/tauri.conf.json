{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArkAgent",
  "version": "../../package.json",
  "identifier": "ai.copilotkit.openbot.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3020",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "ArkAgent",
        "width": 900,
        "height": 640,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "linux": {
      "deb": { "depends": ["pkexec", "procps", "lsof", "ca-certificates"] },
      "rpm": {
        "depends": [
          "/usr/bin/pkexec",
          "/usr/bin/ps",
          "/usr/bin/lsof",
          "ca-certificates"
        ]
      }
    },
    "targets": ["dmg", "nsis", "appimage", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Value Data IKE (BlackArk)",
    "publisher": "Value Data IKE",
    "category": "DeveloperTool",
    "shortDescription": "Run ArkAgent on your own computer",
    "longDescription": "ArkAgent for desktop installs the container engine, raises the stack, and keeps it running."
  }
}
