// Ark on Azure: everything the Helm chart needs underneath it.
//
//   az group create -n rg-ark-prod -l westeurope
//   az deployment group create -g rg-ark-prod -f main.bicep -p main.prod.bicepparam
//
// Read README.md first. Nothing secret is in this template: the database administrator's password is
// a secure parameter supplied at deploy time, and every other secret is put in the vault afterwards by
// scripts/bootstrap-secrets.sh.

targetScope = 'resourceGroup'

@allowed(['dev', 'prod'])
@description('prod turns on zone redundancy, high availability, geo-redundant backups and larger machines.')
param environment string

@description('Western Europe by default: customers are in the EU, and their data stays there.')
param location string = resourceGroup().location

param namePrefix string = 'ark'

@description('Who is mailed when something is wrong, and when the budget is crossed.')
param alertEmail string

@description('Object id of the Entra group whose members administer the cluster.')
param adminGroupObjectId string

@description('Addresses that may reach the cluster API, as CIDR ranges. Empty means anywhere that can sign in, which Entra still has to approve.')
param authorizedIpRanges array = []

@description('The database administrator. Generated by bootstrap-secrets.sh and kept in the vault; never written down elsewhere.')
param postgresAdministratorLogin string = 'arkadmin'
@secure()
param postgresAdministratorPassword string

@description('Where people reach Ark, e.g. https://ark.example.com. Empty skips the availability check.')
param publicUrl string = ''

@description('Euros or dollars a month, whichever the subscription bills in. 0 sets no budget.')
param monthlyBudget int = 0

param kubernetesVersion string = ''
param addressSpace string = '10.40.0.0/16'

@description('Backups copied to the paired region. Needs a region that has one; on by default for prod.')
param geoRedundantBackup bool = environment == 'prod'

var name = '${namePrefix}-${environment}'
var tags = {
  application: 'ark'
  environment: environment
  managedBy: 'bicep'
}
var sizing = {
  dev: {
    databaseSku: 'Standard_B2s'
    databaseTier: 'Burstable'
    databaseStorageGb: 32
    backupDays: 7
    highAvailability: false
    systemVm: 'Standard_D2s_v5'
    workVm: 'Standard_D2s_v5'
    workMin: 1
    workMax: 2
    zones: []
    registrySku: 'Basic'
    logDays: 30
  }
  prod: {
    databaseSku: 'Standard_D2ds_v5'
    databaseTier: 'GeneralPurpose'
    databaseStorageGb: 128
    backupDays: 35
    highAvailability: true
    systemVm: 'Standard_D2s_v5'
    workVm: 'Standard_D4s_v5'
    workMin: 2
    workMax: 6
    zones: ['1', '2', '3']
    registrySku: 'Standard'
    logDays: 90
  }
}[environment]

module monitoring 'modules/monitoring.bicep' = {
  name: 'monitoring'
  params: {
    name: name
    location: location
    retentionDays: sizing.logDays
    alertEmail: alertEmail
    tags: tags
  }
}

module network 'modules/network.bicep' = {
  name: 'network'
  params: {
    name: name
    location: location
    addressSpace: addressSpace
    tags: tags
  }
}

module registry 'modules/registry.bicep' = {
  name: 'registry'
  params: {
    name: name
    location: location
    sku: sizing.registrySku
    tags: tags
  }
}

module vault 'modules/keyvault.bicep' = {
  name: 'keyvault'
  params: {
    name: name
    location: location
    tenantId: tenant().tenantId
    tags: tags
    logAnalyticsWorkspaceId: monitoring.outputs.workspaceId
  }
}

module database 'modules/database.bicep' = {
  name: 'database'
  params: {
    name: name
    location: location
    subnetId: network.outputs.databaseSubnetId
    privateZoneId: network.outputs.privateZoneId
    skuName: sizing.databaseSku
    skuTier: sizing.databaseTier
    storageGb: sizing.databaseStorageGb
    backupRetentionDays: sizing.backupDays
    geoRedundantBackup: geoRedundantBackup
    highAvailability: sizing.highAvailability
    administratorLogin: postgresAdministratorLogin
    administratorPassword: postgresAdministratorPassword
    logAnalyticsWorkspaceId: monitoring.outputs.workspaceId
    tags: tags
  }
}

module cluster 'modules/cluster.bicep' = {
  name: 'cluster'
  params: {
    name: name
    location: location
    tags: tags
    kubernetesVersion: kubernetesVersion
    subnetId: network.outputs.aksSubnetId
    systemVmSize: sizing.systemVm
    userVmSize: sizing.workVm
    userMinCount: sizing.workMin
    userMaxCount: sizing.workMax
    zones: sizing.zones
    adminGroupObjectId: adminGroupObjectId
    authorizedIpRanges: authorizedIpRanges
    logAnalyticsWorkspaceId: monitoring.outputs.workspaceId
    registryId: registry.outputs.id
  }
}

module identity 'modules/identity.bicep' = {
  name: 'identity'
  params: {
    name: name
    location: location
    tags: tags
    oidcIssuerUrl: cluster.outputs.oidcIssuerUrl
    keyVaultName: vault.outputs.name
  }
}

module alerts 'modules/alerts.bicep' = {
  name: 'alerts'
  params: {
    name: name
    location: location
    tags: tags
    actionGroupId: monitoring.outputs.actionGroupId
    databaseId: database.outputs.id
    clusterId: cluster.outputs.id
    insightsId: monitoring.outputs.insightsId
    workspaceId: monitoring.outputs.workspaceId
    healthUrl: publicUrl
    monthlyBudget: monthlyBudget
    budgetEmail: alertEmail
  }
}

output registryLoginServer string = registry.outputs.loginServer
output registryName string = registry.outputs.name
output keyVaultName string = vault.outputs.name
output keyVaultUri string = vault.outputs.uri
output clusterName string = cluster.outputs.name
output databaseHost string = database.outputs.fqdn
output databaseSubnetPrefix string = network.outputs.databaseSubnetPrefix
output secretsIdentityClientId string = identity.outputs.clientId
